    Wave // Wave 1
    {
		// CustomMaxWaveNumber 7 [$SIGSEGV]
        InitWaveOutput
        {
            Target wave_start_relay
            Action runscriptcode
			Param "
				IncludeScript(`popextensions_main`, getroottable())
				IncludeScript(`tankextensions_main`, getroottable())
				IncludeScript(`termination_popext`, getroottable())
				IncludeScript(`claudz_logic_v3`)
				IncludeScript(`tank_repair`)
				PopExt.AddTankName(`emp_tank`, {
					Icon =  {
						name = `tank_red_lite`
						isCrit = true
					}
					Team = 2
					DisableBomb = 1
					DisableTracks = 1
					SpawnTemplate = `temp`
					Model = {
						Default = `models/empty.mdl`
						Damage1 = `models/empty.mdl`
						Damage2 = `models/empty.mdl`
						Damage3 = `models/empty.mdl`
					}
				})
			"
        }
        StartWaveOutput
        {
            Target wave_start_relay
            Action runscriptcode
			Param  "
				EntFire(`wave_start_relay`, `Trigger`)
				EntFire(`disablethesewavespawns`, `Trigger`)
				EntFire(`hudtimer`, `enable`, null, 0.5)
				EntFire(`boton`, `enable`)
				EntFire(`heytouchthis`,`enable`)
				EntFire(`boton`,`unlock`)
				PopExt.SetWaveIconSpawnCount(`sentry_buster_giant_support`, 0, 0)
				PopExt.SetWaveIconSpawnCount(`heavy_mittens`, 0, 0)
			"
        }
        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
		WaveSpawn
		{
			WaitForAllSpawned wavemainfocus
			TotalCurrency	0
			TotalCount	1
			MaxActive	1
			SpawnCount	1
			// HideIcon 1 [$SIGSEGV]
			WaitBeforeStarting	13
			WaitBetweenSpawns	1
			Where	spawnbot_side_1
			TFBot
			{
				Template	T_TFBot_SentryBuster
				ClassIcon 	sentry_buster_giant_support
				// SpawnTemplate imsolazyilldothis [$SIGSEGV]
				// UseBusterModel 1 [$SIGSEGV]
				// Action SuicideBomber [$SIGSEGV]
				Health 3
				Tag giant
				Tag "popext_suicidecounter{ amount = 1.0 }"
				Tag "popext_spawntemplate{ template = `imsolazyilldothis` }"
				Tag "popext_usecustommodel{ model = `models/bots/demo/bot_sentry_buster.mdl` }"
				// doesn't work yet, will be fixed in next update
				Tag "popext_mission{
					mission = MISSION_DESTROY_SENTRIES,
					suicide_bomber = true
				}"
				Tag "popext_fireinput{
					target = `!self`,
					action = `RunScriptCode`,
					param = `self.SetOrigin(Vector(-1104, 7645, 688))`
				}"
