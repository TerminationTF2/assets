	SpawnTemplate steamhappey
	Wave
	{
		InitWaveOutput
		{
			Target Wave5Relay
			Action runscriptcode
			Param "
                ClientPrint(null, 2, `start runscriptcode block`)

                // The original InitWaveOutput trigger, change if necessary
                EntFire(`Wave5Relay`, `Trigger`)

                // Load popextensions script
                IncludeScript(`popextensions_main`)
                ClientPrint(null, 2, `load pop extension`)
                ClientPrint(null, 2, `load custom vscript`)

                // Add event hooks for bots with specifed Tag.
                PopExt.AddRobotTag(`abc`, {
                    // Called when the robot is spawned
                    OnSpawn = function(bot, tag) {
                        ClientPrint(null, 2, `OnSpawn`)
                        PopExtUtil.CreatePlayerWearable(bot, `models\giant_pyro_exhaust_backpack.mdl`, false, `head`)
                    },
                })
            "
			Delay 0.1
		}
		StartWaveOutput
		{
			Target wave_start_relay
			Action Trigger
		}
		DoneOutput
		{
			Target wave_finished_relay
			Action Trigger
		}
