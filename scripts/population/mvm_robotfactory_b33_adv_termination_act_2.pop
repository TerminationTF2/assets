	Templates
	{
		unstablecharge
        {
            SpawnTemplate unstablecharge
            Item "Wavefinder"
            FireInput
            {
                Target "!self"
                Action "IgnitePlayer"
                Repeats 9999
                Delay 1
                Cooldown 1
            }
            AddCond
            {
                Index 70
            }
            FireInput
            {
                IfHealthBelow 2
                Delay 2
                Target !self
                Action $suicide
            }
            FireInput
            {
                IfHealthBelow 2
                Delay 1.3
                Target !self
                Action $PlaySound
                Param "items\cart_explode_trigger.wav"
            }
            CharacterAttributes
            {
                "attach particle effect" 236
                "voice pitch scale" 1.45
            }
            VoiceCommand
            {
                Delay 3
                Cooldown 3
                Type "Help"
            }
		}
