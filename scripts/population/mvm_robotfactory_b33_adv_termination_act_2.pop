				}
				
				InterruptAction   // Stop current bot ai and force the bot to move to a location
				{
					Target "1282 -2918 0" // Entity / bot / class name as an alternative. Also: RandomEnemy, ClosestPlayer
					AimTarget "1282 -2918 0" // Entity / bot / class name as an alternative. Also: RandomEnemy, ClosestPlayer
					KillAimTarget 1 // Attack aim target (Default: 0)
					Delay 1 // Time before the first task starts. Must be above 0, or it will not execute (Default: 10)
                    Repeats 1 // How many times should bot do the task in total (Default: 0 - Infinite)
					Duration 9999 // How long should the ai be interrupted
					WaitUntilDone 1 // If set, duration timer only starts when the bot moves to the target location or the aim target is killed (Default: 0)
				}
			}
			FirstSpawnOutput
			{
				Target "musicforw4"
				Action "Trigger"
			}
			DoneOutput
			{
				Target red_lose_relay
				Action Trigger
			}
		}
		
