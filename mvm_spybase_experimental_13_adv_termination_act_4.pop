    Wave // Wave 1
    {
        CustomWaveNumber 6
		CustomMaxWaveNumber 7
        StartWaveOutput
        {
            Target wave_start_relay
            Action runscriptcode
			Param "
			    EntFire(`prop_engitank_waiting*`, `Kill`)
			    EntFire(`red_blocker`, `Kill`)
			    EntFire(`red_blocker2`, `Kill`, ``, 22)
			    EntFire(`carrier_door_front`, `SetAnimation`, `door_open`, 28) // adding this here and not to the main logic just because it is temporary
			    EntFire(`carrier_door_front`, `SetAnimation`, `open`, 34.67)
			    EntFire(`tf_point_nav_interface`, `RecomputeBlockers`, ``, 34.68)
			"
        }
        InitWaveOutput
        {
            Target wave_start_relay
            Action runscriptcode
			Param "
			IncludeScript(`tankextensions_main`, getroottable())
            IncludeScript(`claudz_logic_v3`)
            IncludeScript(`tankextensions/combattank`, getroottable())
            IncludeScript(`tankextensions/combattank_weapons/minigun`, getroottable())
            IncludeScript(`tankextensions/combattank_weapons/rocketpod`, getroottable())
			IncludeScript(`tankextensions/combattank_weapons/fireball`, getroottable())
            EntFire(`autologic`,`forcespawn`)
            EntFire(`teleporters`,`forcespawn`)
			EntFire(`bombpath_clearall_relay`, `Trigger`)
			EntFire(`tank_lift_lowered`, `Enable`)
			Convars.SetValue(`tf_playergib`, 0)
			"
        }
		SpawnTemplate teleporters
        DoneOutput
        {
            Target wave_finished_relay
            Action Trigger
        }
