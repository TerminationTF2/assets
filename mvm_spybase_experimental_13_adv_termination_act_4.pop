				"OnTrigger" "tank_path_australium_31,AddOutput,OnPass pop_interface:$ResumeWavespawn:suddenambush:4:-1,0,-1"
				"OnTrigger" "tank_path_australium_31,AddOutput,OnPass alright_lets_give_you_a_shortcut_now:trigger::12:-1,0,-1"
