				"OnTrigger" "pop_interface,$PauseWavespawn,secondchief,0,-1"
				"OnTrigger" "pop_interface,$PauseWavespawn,suddenambush,0,-1"
				"OnTrigger" "pop_interface,$PauseWavespawn,third_chief,0,-1"
				"OnTrigger" "tank_path_australium_10,AddOutput,OnPass payloadtank:SetSpeed:36:0:-1,0,-1"
